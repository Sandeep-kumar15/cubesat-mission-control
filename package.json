{
  "name": "cubesat-mission-control",
  "version": "1.0.0",
  "description": "CubeSat Mission Control dashboard desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.spacespark.cubesat",
    "productName": "CubeSat Mission Control",
    "files": ["main.js", "index.html", "assets/**/*"],
    "directories": { "output": "dist" }
  }
}
